OPENSOLAR_API_TOKEN=paste_your_bearer_token_here
OPENSOLAR_ORG_ID=12345
# OpenSolar API base URL. Trailing slash will be auto-appended if missing.
OPENSOLAR_BASE_URL=https://api.opensolar.com/api/

# Optional tool surface filters
# OPENSOLAR_TOOLSETS=projects,contacts,events,org
# OPENSOLAR_READ_ONLY=1
# OPENSOLAR_PLAN=api_access

# HTTP transport (or pass --http)
# MCP_TRANSPORT=http
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=3000
# MCP_HTTP_PATH=/mcp
# Required when binding 0.0.0.0 or ::
# MCP_HTTP_ALLOWED_HOSTS=example.com

