OPENSOLAR_API_TOKEN=paste_your_bearer_token_here
OPENSOLAR_ORG_ID=12345
# OpenSolar API base URL. Trailing slash will be auto-appended if missing.
OPENSOLAR_BASE_URL=https://api.opensolar.com/api/

# Optional tool surface filters.
# agent is the default operational surface. full registers all 75 tools.
# An explicit OPENSOLAR_TOOLSETS list overrides profile membership.
# OPENSOLAR_PROFILE=agent
# OPENSOLAR_PROFILE=full
# OPENSOLAR_TOOLSETS=projects,org,contacts,events,systems,components,workflow,payment,pricing,costing,reference,files,webhooks,teams,raw_data
# OPENSOLAR_READ_ONLY=1
# OPENSOLAR_PLAN=api_access

# Local file uploads are disabled unless this is set. create_private_file may
# read only files whose resolved real path remains inside this directory.
# OPENSOLAR_UPLOAD_ROOT=/absolute/path/to/uploads

# HTTP transport (or pass --http)
# MCP_TRANSPORT=http
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=3000
# MCP_HTTP_PATH=/mcp
# Required when binding 0.0.0.0 or ::
# MCP_HTTP_ALLOWED_HOSTS=example.com
# Non-loopback HTTP ignores OPENSOLAR_API_TOKEN as a request fallback.
# Each MCP request must send Authorization: Bearer <OpenSolar token>.
# Terminate TLS before exposing the HTTP endpoint to the internet.

# Optional live integration. Credentials alone run reads. Writes stay off unless this is 1.
# OPENSOLAR_INTEGRATION_WRITES=1
# Dedicated fixture project for a live stage restore. Not an arbitrary customer project.
# OPENSOLAR_TEST_PROJECT_ID=
# Existing connected org for preflight_project_share. This suite does not create one.
# OPENSOLAR_TEST_CONNECTED_ORG_ID=

