{
  "name": "@alignco/opensolar-mcp",
  "version": "0.1.0-rc.1",
  "description": "Unofficial, self-hosted Model Context Protocol server for the OpenSolar API",
  "mcpName": "io.github.align-software-company/opensolar-mcp",
  "packageManager": "pnpm@10.34.5",
  "author": "Align Software Company",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Align-Software-Company/opensolar-mcp.git"
  },
  "homepage": "https://github.com/Align-Software-Company/opensolar-mcp#readme",
  "bugs": {
    "url": "https://github.com/Align-Software-Company/opensolar-mcp/issues"
  },
  "keywords": [
    "opensolar",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "solar",
    "solar-api"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "opensolar-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/index.ts --http",
    "prepack": "pnpm check:all && pnpm build",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:repo": "node scripts/repo-hygiene.mjs",
    "check:registry": "node scripts/registry-check.mjs",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:docker": "node scripts/docker-smoke.mjs",
    "check:all": "pnpm lint:repo && pnpm check:registry && pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/hono": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "hono": "^4.13.8",
    "unpdf": "^1.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^24.13.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
