{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.align-software-company/opensolar-mcp",
  "title": "OpenSolar MCP",
  "description": "Unofficial, self-hosted MCP server for the documented OpenSolar API.",
  "version": "0.1.0",
  "websiteUrl": "https://github.com/Align-Software-Company/opensolar-mcp",
  "repository": {
    "url": "https://github.com/Align-Software-Company/opensolar-mcp",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@alignco/opensolar-mcp",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "OPENSOLAR_API_TOKEN",
          "description": "OpenSolar bearer token",
          "format": "string",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "OPENSOLAR_ORG_ID",
          "description": "OpenSolar organisation ID",
          "format": "number",
          "isRequired": true,
          "isSecret": false,
          "placeholder": "12345"
        }
      ]
    }
  ]
}
